# ========================================================
# 로컬 개발용 환경변수 설정 예시 (.env.development)
# 실제 공용 DB(RDS) 동기화 방지를 위해 로컬 PostgreSQL을 사용합니다.
# 이 파일을 복사하여 .env.development 로 저장하고 필요에 따라 수정하세요.
# ========================================================

# PostgreSQL 로컬 개발 DB 접속 정보
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=takeme_dev
DB_SSL=false

# 보안 및 토큰 설정
JWT_SECRET=takeme-local-dev-jwt-secret-key-2026-development-only
JWT_EXPIRES_IN=60m
ALLOW_MULTIPLE_SESSIONS=true
ENCRYPTION_KEY='TakemeSecureMasterKey2026!@#$'

# 카카오 지도/길찾기 API (개발용)
KAKAO_REST_API_KEY=f94edc6ab533d7973a4fc72f4125c1a5
