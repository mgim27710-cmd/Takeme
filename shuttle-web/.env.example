# 이 파일을 .env.local 로 복사해서 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)
#
# 네이버 클라우드 플랫폼 > Maps > Application 의 Client ID
# NCP 콘솔의 Web 서비스 URL 에 웹 주소를 등록해야 동작합니다.
#   예) https://52.63.245.203.sslip.io   (끝에 / 나 경로 없이 주소만)
#       http://localhost:5173            (내 컴퓨터에서 npm run dev 할 때)
# 비워 두면 OpenStreetMap 지도를 사용합니다.
VITE_NAVER_MAP_CLIENT_ID=w5mmkij4lq

# (선택) API 서버 주소. 비워 두면 웹이 열린 주소를 그대로 사용합니다.
# VITE_API_URL=
